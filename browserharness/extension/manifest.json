{
  "manifest_version": 3,
  "name": "BrowserHarness",
  "version": "0.1.1",
  "description": "Lets the BrowserHarness page call model servers and public URLs that do not allow this website.",
  "permissions": ["declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
